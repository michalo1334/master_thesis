{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explorer": {
      "disable": true
    }
  },
  "mcp": {
    "svelte": {
      "type": "remote",
      "url": "https://mcp.svelte.dev/mcp"
    }
  },
  "provider": {
    "runinfra": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        }
      }
    }
  },

  "instructions": [".opencode/instructions/opencode-agents.md"],
  "permission": "allow",
  "plugin": ["@dietrichgebert/ponytail"] 
}
