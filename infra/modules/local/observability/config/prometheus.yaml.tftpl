global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    service: ${service_name}

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          component: host

  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          component: containers

  - job_name: postgres
    static_configs:
      - targets: ["postgres-exporter:9187"]
        labels:
          component: database

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          component: self
