global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    service: ${service_name}

scrape_configs:
  - job_name: otel-collectors
    honor_labels: true
    static_configs:
      - targets: ${jsonencode([for site in keys(sites) : "otel-collector-${site}:8889"])}

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          component: host

  - job_name: cadvisor
    static_configs:
      - targets: ["cadvisor:8080"]
        labels:
          component: containers

  - job_name: postgres
    static_configs:
      - targets: ["postgres-exporter:9187"]
        labels:
          component: database

  - job_name: redis
    static_configs:
      - targets: ["redis-exporter:9121"]
        labels:
          component: cache

  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          component: self
