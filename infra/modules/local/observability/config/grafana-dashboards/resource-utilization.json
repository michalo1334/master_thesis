{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Host",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Host CPU utilization",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 1},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "{{instance}}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Host memory utilization",
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 1},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})", "legendFormat": "{{instance}}", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Host load average",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "node_load1{job=\"node\"}", "legendFormat": "1 min", "refId": "A"},
        {"expr": "node_load5{job=\"node\"}", "legendFormat": "5 min", "refId": "B"},
        {"expr": "node_load15{job=\"node\"}", "legendFormat": "15 min", "refId": "C"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Filesystem utilization",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Host disk throughput",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (device) (rate(node_disk_read_bytes_total{job=\"node\"}[$__rate_interval]))", "legendFormat": "{{device}} read", "refId": "A"},
        {"expr": "sum by (device) (rate(node_disk_written_bytes_total{job=\"node\"}[$__rate_interval]))", "legendFormat": "{{device}} write", "refId": "B"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host network throughput",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (device) (rate(node_network_receive_bytes_total{job=\"node\",device!~\"lo\"}[$__rate_interval]))", "legendFormat": "{{device}} receive", "refId": "A"},
        {"expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=\"node\",device!~\"lo\"}[$__rate_interval]))", "legendFormat": "{{device}} transmit", "refId": "B"}
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Containers",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container CPU utilization",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
      "fieldConfig": {"defaults": {"min": 0, "unit": "percent", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval])) * 100", "legendFormat": "{{name}}", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container memory utilization",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
      "fieldConfig": {"defaults": {"min": 0, "unit": "percent", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\"} / container_spec_memory_limit_bytes{job=\"cadvisor\",name!=\"\"}", "legendFormat": "{{name}}", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Container network throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}} receive", "refId": "A"},
        {"expr": "sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}} transmit", "refId": "B"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Container block I/O",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (name) (rate(container_fs_reads_bytes_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}} read", "refId": "A"},
        {"expr": "sum by (name) (rate(container_fs_writes_bytes_total{job=\"cadvisor\",name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}} write", "refId": "B"}
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "BEAM",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41}
    },
    {
      "id": 14,
      "type": "gauge",
      "title": "BEAM CPU utilization",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 42},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{"expr": "vm_cpu_utilization_percent{job=\"network_defense\"}", "refId": "A"}]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "BEAM memory total",
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 42},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"},
      "targets": [{"expr": "vm_memory_total_bytes{job=\"network_defense\"}", "refId": "A"}]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "BEAM CPU per core",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 42},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "vm_cpu_per_core_percent{job=\"network_defense\"}", "legendFormat": "core {{core}}", "refId": "A"}]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "BEAM memory breakdown",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
      "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}, "custom": {"stacking": {"group": "A", "mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "vm_memory_processes_bytes{job=\"network_defense\"}", "legendFormat": "processes", "refId": "A"},
        {"expr": "vm_memory_ets_bytes{job=\"network_defense\"}", "legendFormat": "ETS", "refId": "B"},
        {"expr": "vm_memory_binary_bytes{job=\"network_defense\"}", "legendFormat": "binary", "refId": "C"},
        {"expr": "vm_memory_system_bytes{job=\"network_defense\"}", "legendFormat": "system", "refId": "D"}
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "BEAM scheduler run queues",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "vm_total_run_queue_lengths_total{job=\"network_defense\"}", "legendFormat": "total", "refId": "A"},
        {"expr": "vm_total_run_queue_lengths_cpu{job=\"network_defense\"}", "legendFormat": "CPU", "refId": "B"},
        {"expr": "vm_total_run_queue_lengths_io{job=\"network_defense\"}", "legendFormat": "I/O", "refId": "C"}
      ]
