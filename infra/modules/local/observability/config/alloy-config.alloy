loki.source.file "network_defense" {
  targets = [
    {
      __path__     = "/var/log/${service_name}/app.*.*.jsonl",
      job          = "${service_name}",
      service_name = "${service_name}",
    },
  ]
  forward_to = [loki.process.network_defense.receiver]
  file_match {
    enabled     = true
    sync_period = "10s"
  }
  file_watch {
    min_poll_frequency = coalesce(sys.env("ALLOY_LOG_POLL_FREQUENCY"), "250ms")
    max_poll_frequency = coalesce(sys.env("ALLOY_LOG_POLL_FREQUENCY"), "250ms")
  }
}

loki.process "network_defense" {
  forward_to = [loki.write.network_defense.receiver]

  stage.json {
    expressions = {
      level          = "severity",
      trace_id       = "trace",
      span_id        = "span",
      request_id     = "metadata.request_id",
      correlation_id = "metadata.correlation_id",
      time           = "time",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.regex {
    source     = "filename"
    expression = ".*app\\.(?P<site>[a-z0-9-]+)\\.(?P<replica>[0-9]+)\\.jsonl"
  }

  stage.labels {
    values = { level = "", site = "", replica = "" }
  }

  stage.structured_metadata {
    values = { trace_id = "", span_id = "", request_id = "", correlation_id = "" }
  }
}

loki.write "network_defense" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
