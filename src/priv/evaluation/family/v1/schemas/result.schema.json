{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "FamilyResult",
  "description": "Persisted corrected family result for one declared primary family.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_role",
    "family_id",
    "method",
    "alpha",
    "family_size",
    "comparisons"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "evidence_role": {"type": "string", "enum": ["synthetic_prototype"]},
    "family_id": {"$ref": "#/definitions/identifier"},
    "method": {"type": "string", "enum": ["holm"]},
    "alpha": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true,
      "maximum": 1,
      "exclusiveMaximum": true
    },
    "family_size": {"type": "integer", "minimum": 1},
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/family_comparison"}
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "budget", "alternative", "reference", "outcome"],
      "properties": {
        "tier": {"$ref": "#/definitions/identifier"},
        "budget": {"type": "integer", "minimum": 1},
        "alternative": {"$ref": "#/definitions/identifier"},
        "reference": {"$ref": "#/definitions/identifier"},
        "outcome": {"$ref": "#/definitions/identifier"}
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjusted_p_value", "reject_null"],
      "properties": {
        "adjusted_p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "reject_null": {"type": "boolean"}
      }
    },
    "family_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "statistics", "adjustment"],
      "properties": {
        "identity": {"$ref": "#/definitions/identity"},
        "statistics": {
          "description": "One ComparisonStatistics. The nested comparison contract owns this shape.",
          "type": "object"
        },
        "adjustment": {"$ref": "#/definitions/adjustment"}
      }
    }
  }
}
