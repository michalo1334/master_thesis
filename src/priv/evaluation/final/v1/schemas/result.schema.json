{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "FinalResult",
  "description": "Persisted Final result for one declared primary family. It repeats the Final source binding, keeps the per-comparison intervals unchanged, and adds one Holm adjustment row per declared identity in declared order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_role",
    "assertion_basis",
    "family_id",
    "method",
    "alpha",
    "family_size",
    "study_revision_id",
    "snapshot_id",
    "source_pilot_run_id",
    "plan_count",
    "attacks_per_plan",
    "assertions",
    "comparisons"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "evidence_role": {"type": "string", "enum": ["final"]},
    "assertion_basis": {"type": "string", "enum": ["caller_asserted"]},
    "family_id": {"$ref": "#/definitions/identifier"},
    "method": {"type": "string", "enum": ["holm"]},
    "alpha": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true,
      "maximum": 1,
      "exclusiveMaximum": true
    },
    "family_size": {"type": "integer", "minimum": 1},
    "study_revision_id": {"$ref": "#/definitions/uuid"},
    "snapshot_id": {"$ref": "#/definitions/uuid"},
    "source_pilot_run_id": {"type": "integer", "minimum": 1},
    "plan_count": {"type": "integer", "minimum": 1},
    "attacks_per_plan": {"type": "integer", "minimum": 1},
    "assertions": {"$ref": "#/definitions/assertions"},
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/final_comparison"}
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "budget", "alternative", "reference", "outcome"],
      "properties": {
        "tier": {"$ref": "#/definitions/identifier"},
        "budget": {"type": "integer", "minimum": 1},
        "alternative": {"$ref": "#/definitions/identifier"},
        "reference": {"type": "string", "enum": ["cvss"]},
        "outcome": {"type": "string", "enum": ["mission_impact"]}
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_evidence_collected_after_pilot",
        "pilot_observations_excluded",
        "collection_completed_at"
      ],
      "properties": {
        "final_evidence_collected_after_pilot": {"type": "boolean", "enum": [true]},
        "pilot_observations_excluded": {"type": "boolean", "enum": [true]},
        "collection_completed_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
        }
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjusted_p_value", "reject_null"],
      "properties": {
        "adjusted_p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "reject_null": {"type": "boolean"}
      }
    },
    "final_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "statistics", "adjustment"],
      "properties": {
        "identity": {"$ref": "#/definitions/identity"},
        "statistics": {
          "description": "One ComparisonStatistics. The nested comparison contract owns this shape.",
          "type": "object"
        },
        "adjustment": {"$ref": "#/definitions/adjustment"}
      }
    }
  }
}
