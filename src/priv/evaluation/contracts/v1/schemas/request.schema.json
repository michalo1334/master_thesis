{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ComparisonRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence", "resampling", "interval", "test"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "evidence": {"$ref": "#/definitions/evidence"},
    "resampling": {"$ref": "#/definitions/resampling"},
    "interval": {"$ref": "#/definitions/interval"},
    "test": {"$ref": "#/definitions/test"}
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mission_impacts"],
      "properties": {
        "id": {"$ref": "#/definitions/identifier"},
        "mission_impacts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        }
      }
    },
    "alternative_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "plans"],
      "properties": {
        "strategy": {
          "allOf": [
            {"$ref": "#/definitions/identifier"},
            {"not": {"enum": ["cvss"]}}
          ]
        },
        "plans": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/definitions/plan"}
        }
      }
    },
    "reference_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "plans"],
      "properties": {
        "strategy": {"type": "string", "enum": ["cvss"]},
        "plans": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/definitions/plan"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "attack_seeds", "alternative", "reference"],
      "properties": {
        "outcome": {"type": "string", "enum": ["mission_impact"]},
        "attack_seeds": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "alternative": {"$ref": "#/definitions/alternative_side"},
        "reference": {"$ref": "#/definitions/reference_side"}
      }
    },
    "resampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "replicates"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "replicates": {"type": "integer", "minimum": 1}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence_level"],
      "properties": {
        "confidence_level": {"type": "number", "exclusiveMinimum": true, "minimum": 0, "exclusiveMaximum": true, "maximum": 1}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternative"],
      "properties": {
        "alternative": {"type": "string", "enum": ["two_sided"]}
      }
    }
  }
}
