{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "PilotRequest",
  "description": "Strict versioned Precision Pilot declaration. Every scientific value is declared by the caller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_role",
    "method",
    "pilot_id",
    "study_revision_id",
    "family_id",
    "snapshot_id",
    "expected_comparisons",
    "candidates",
    "pilot_sampling",
    "precision",
    "selection"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "pilot"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "precision_pilot_v1"
      ]
    },
    "pilot_id": {
      "$ref": "#/definitions/identifier"
    },
    "study_revision_id": {
      "$ref": "#/definitions/uuid"
    },
    "family_id": {
      "$ref": "#/definitions/identifier"
    },
    "snapshot_id": {
      "$ref": "#/definitions/uuid"
    },
    "expected_comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/identity"
      }
    },
    "pilot_sampling": {
      "$ref": "#/definitions/pilot_sampling"
    },
    "precision": {
      "$ref": "#/definitions/precision"
    },
    "selection": {
      "$ref": "#/definitions/selection"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/candidate"
      }
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "budget",
        "alternative",
        "reference",
        "outcome"
      ],
      "properties": {
        "tier": {
          "$ref": "#/definitions/identifier"
        },
        "budget": {
          "type": "integer",
          "minimum": 1
        },
        "alternative": {
          "$ref": "#/definitions/identifier"
        },
        "reference": {
          "type": "string",
          "enum": [
            "cvss"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "mission_impact"
          ]
        }
      }
    },
    "pilot_sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer_subsamples",
        "seed"
      ],
      "properties": {
        "outer_subsamples": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_half_width",
        "guard_quantile",
        "confidence_level",
        "bootstrap_replicates"
      ],
      "properties": {
        "target_half_width": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true
        },
        "guard_quantile": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 1,
          "exclusiveMaximum": true
        },
        "confidence_level": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true,
          "maximum": 1,
          "exclusiveMaximum": true
        },
        "bootstrap_replicates": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "lowest_predicted_runtime"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "plan_count",
        "attacks_per_plan"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "plan_count": {
          "type": "integer",
          "minimum": 5
        },
        "attacks_per_plan": {
          "type": "integer",
          "minimum": 10
        }
      }
    }
  }
}
