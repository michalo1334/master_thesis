# ── Database ──────────────────────────────────────────
# POSTGRES_* configure the postgres Docker container.
# REPO_* (REPO_USERNAME, REPO_PASSWORD, REPO_DATABASE) are read by the Elixir
# app and fall back to POSTGRES_* when unset.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=network_defense_dev
REPO_HOSTNAME=localhost

# ── Observability ─────────────────────────────────────
# Used by docker/docker-compose.yml for the grafana container
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ORG_ROLE=Viewer

# Used by docker-compose overlays for the Elixir app container
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=network_defense

# ── Phoenix / Endpoint ────────────────────────────────
# Required in production; generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Hostname, IP, and port the Phoenix server binds to
PHX_HOST=localhost
PHX_IP=0.0.0.0
PORT=4000

# Set PHX_SERVER=true to start the server in a release
# PHX_SERVER=true

# Production DATABASE_URL (overrides individual REPO_* vars)
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE

# Connection pool size (default: 10)
# POOL_SIZE=10

# Enable IPv6 for Ecto (set to "true" or "1")
# ECTO_IPV6=false

# DNS cluster query (optional, for distributed Erlang)
# DNS_CLUSTER_QUERY=

# Signing salts for LiveView and session cookies
LIVE_VIEW_SIGNING_SALT=32w8i9Ge
SESSION_COOKIE_KEY=_network_defense_key
SESSION_SIGNING_SALT=zHOd9+N1

# ── Build (Frontend) ──────────────────────────────────
# Set by PhoenixVite during compilation; not typically user-set
# MIX_BUILD_PATH=
# NODE_ENV=development
