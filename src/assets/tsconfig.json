{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "live_svelte": ["../deps/live_svelte/assets/js/live_svelte/types.d.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["js/**/*.ts", "js/**/*.d.ts", "svelte/**/*.svelte"]
}
