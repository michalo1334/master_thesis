# Development Dockerfile — multi-stage, mirrors the production Dockerfile structure.
#
# Builder stage: installs deps and compiles the app so the runner doesn't need
# to re-fetch dependencies on every container restart.
#
# Runner stage: same base image so `mix`, `iex`, and Node.js are available for
# hot-reload, bind-mounted source changes, and interactive debugging.
#
# Usage:
#   ./docker/up.sh dev

ARG ELIXIR_VERSION=1.20.2
ARG OTP_VERSION=29.0.3
ARG DEBIAN_VERSION=trixie-20260623-slim

ARG BUILDER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"
ARG RUNNER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"

FROM ${BUILDER_IMAGE} AS builder

# install build dependencies
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# install Node.js for Vite asset build + LiveSvelte SSR
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y nodejs \
  && rm -rf /var/lib/apt/lists/*

# install hex + rebar
RUN mix local.hex --force && mix local.rebar --force

# prepare build dir
WORKDIR /app

# keep build artifacts separate from host-side _build
ENV MIX_BUILD_PATH=/app/_build_docker

# install mix dependencies
COPY mix.exs mix.lock ./
COPY .formatter.exs ./
COPY prettier.config.mjs ./
RUN mix deps.get

# copy compile-time config and compile deps
COPY config config
RUN mix deps.compile

# install npm packages
COPY package.json package-lock.json ./
COPY lib/network_defense/runtime_config.ex lib/network_defense/
RUN mix compile
RUN mix assets.setup

# copy source and compile
COPY lib lib
COPY priv priv
COPY assets assets
COPY test test
RUN mix compile

# ---- runner stage ----
FROM ${RUNNER_IMAGE} AS runner

# install runtime tools (build-essential for native deps, inotify-tools for hot-reload, tini for signal forwarding)
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git curl ca-certificates inotify-tools tini \
  && rm -rf /var/lib/apt/lists/*

# install Node.js for Vite HMR + LiveSvelte SSR
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y nodejs \
  && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app

ENV MIX_BUILD_PATH=/app/_build_docker

# copy compiled deps and source from builder — source will be overridden by bind mounts
COPY --from=builder /app .

EXPOSE 4000
EXPOSE 5173

ENTRYPOINT ["/usr/bin/tini", "--"]

# start with hot-reload (source code is mounted as a volume at runtime)
CMD ["sh", "-c", "mix deps.get && iex -S mix phx.server"]
