{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Vite (Docker)",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}/src/assets",
      "remoteRoot": "/app/assets",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/src/assets/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
