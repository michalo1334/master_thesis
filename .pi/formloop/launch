#!/usr/bin/env bash
# A shared local Formloop service, with one stdio MCP process per client.
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: bash .pi/formloop/launch [--dry-run] up|down|build|status|logs|mcp' \
    '  up       Build if needed, start, and wait for the shared service.' \
    '  down     Stop and remove the owned service. In-memory forms are lost.' \
    '  build    Build the pinned image without replacing a running service.' \
    '  status   Show the service status.' \
    '  logs     Show the last 100 service log lines.' \
    '  mcp      Ensure the service is ready, then run the stdio MCP bridge.' \
    '  --dry-run  Print commands without contacting Docker or creating state.' \
    '  --help     Show this help.' \
    'Environment: FORMLOOP_PORT (default 3847), FORMLOOP_PROJECT (default agent-lib-formloop).' \
    'Requires Bash, a local Docker engine, Docker Compose v2, and flock (util-linux).' \
    'Forms and submissions are held in memory. Open returned form URLs manually.'
}

fail() { printf 'Formloop: %s\n' "$*" >&2; exit 1; }

parse_args() {
  ACTION='' DRY_RUN=0
  while (($#)); do
    case "$1" in
      --help|-h) usage; exit 0 ;;
      --dry-run) DRY_RUN=1 ;;
      up|down|build|status|logs|mcp)
        [[ -z "$ACTION" ]] || fail 'Choose one action.'
        ACTION=$1 ;;
      *) fail "Unknown argument: $1" ;;
    esac
    shift
  done
  [[ -n "$ACTION" ]] || fail 'Choose an action. Use --help for options.'
}

configure() {
  ASSET_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  export FORMLOOP_PORT=${FORMLOOP_PORT:-3847}
  export FORMLOOP_PROJECT=${FORMLOOP_PROJECT:-agent-lib-formloop}
  [[ "$FORMLOOP_PORT" =~ ^[1-9][0-9]{0,4}$ ]] && ((FORMLOOP_PORT <= 65535)) || fail 'Invalid FORMLOOP_PORT.'
  [[ "$FORMLOOP_PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail 'Invalid FORMLOOP_PROJECT.'
  [[ -f "$ASSET_DIR/compose.yaml" && -f "$ASSET_DIR/Dockerfile" ]] || fail 'Docker assets are missing.'
  COMPOSE=(docker compose --project-name "$FORMLOOP_PROJECT" --file "$ASSET_DIR/compose.yaml")
  START=("${COMPOSE[@]}" up --build --detach --wait --wait-timeout 60)
  MCP=("${COMPOSE[@]}" exec --no-TTY formloop node /app/mcp-entry.mjs)
}

print_command() { printf ' ' >&2; printf '%q ' "$@" >&2; printf '\n' >&2; }

preview() {
  case "$ACTION" in
    up) print_command "${START[@]}" ;;
    down|build) print_command "${COMPOSE[@]}" "$ACTION" ;;
    status) print_command "${COMPOSE[@]}" ps --all ;;
    logs) print_command "${COMPOSE[@]}" logs --no-color --tail 100 formloop ;;
    mcp) print_command "${START[@]}"; print_command "${MCP[@]}" ;;
  esac
}

require_runtime() {
  command -v docker >/dev/null || fail 'Install Docker first.'
  command -v flock >/dev/null || fail 'Install flock (util-linux) first.'
  docker compose version >/dev/null || fail 'Docker Compose v2 is required.'
  local endpoint
  if [[ -n "${DOCKER_HOST:-}" && -z "${DOCKER_CONTEXT:-}" ]]; then
    endpoint=$DOCKER_HOST
  else
    endpoint=$(docker context inspect --format '{{(index .Endpoints "docker").Host}}')
  fi
  [[ "$endpoint" == unix://* ]] || fail 'Use a local Docker socket. Remote engines cannot serve these localhost links.'
  docker info >/dev/null || fail 'The Docker engine is unavailable.'
}

lock_service() {
  local state_dir=${XDG_STATE_HOME:-${HOME:?HOME is required}/.local/state}/agent-lib/formloop
  umask 077
  mkdir -p -- "$state_dir"
  exec 9>"$state_dir/$FORMLOOP_PROJECT.lock"
  flock --exclusive --timeout 120 9 || fail 'Another launcher operation holds the service lock.'
}

unlock_service() { flock --unlock 9; exec 9>&-; }

find_owned_container() {
  CONTAINER=$("${COMPOSE[@]}" ps --all --quiet formloop)
  [[ "$CONTAINER" != *$'\n'* ]] || fail 'Multiple service containers were found.'
  if [[ -n "$CONTAINER" ]]; then
    local owner
    owner=$(docker inspect --format '{{index .Config.Labels "io.michalo.agent-lib.formloop"}}' "$CONTAINER")
    [[ "$owner" == 1 ]] || fail 'The existing container is not owned by this launcher. Choose another FORMLOOP_PROJECT.'
  fi
}

check_compatible_service() {
  local image expected binding
  expected=$("${COMPOSE[@]}" config --images)
  image=$(docker inspect --format '{{.Config.Image}}' "$CONTAINER")
  [[ "$image" == "$expected" ]] || fail 'The existing image differs. Stop the owned service before changing versions.'
  binding=$(docker inspect --format '{{range (index .NetworkSettings.Ports "3847/tcp")}}{{.HostIp}}:{{.HostPort}}{{end}}' "$CONTAINER")
  [[ "$binding" == "127.0.0.1:$FORMLOOP_PORT" ]] || fail 'The service uses a different port or binding. Match FORMLOOP_PORT, or stop it first.'
}

ensure_service() {
  if [[ -n "$CONTAINER" ]] && [[ $(docker inspect --format '{{.State.Running}}' "$CONTAINER") == true ]]; then
    check_compatible_service
    local health
    health=$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER")
    if [[ "$health" == healthy ]]; then return; fi
    # Do not recreate an existing process while it starts: that would lose forms.
    for ((attempt=0; attempt<60; attempt++)); do
      health=$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER")
      [[ "$health" != unhealthy ]] || fail 'The service is unhealthy. Inspect its logs before restarting it.'
      if [[ "$health" == healthy ]]; then return; fi
      sleep 1
    done
    fail 'The service did not become healthy within 60 seconds.'
  fi
  "${START[@]}" >&2
}

main() {
  parse_args "$@"
  configure
  if ((DRY_RUN)); then preview; return; fi
  require_runtime
  lock_service
  find_owned_container
  case "$ACTION" in
    up|mcp) ensure_service ;;
    down)
      if [[ -n "$CONTAINER" ]]; then "${COMPOSE[@]}" down >&2; fi ;;
    build) "${COMPOSE[@]}" build >&2 ;;
    status) "${COMPOSE[@]}" ps --all ;;
    logs) "${COMPOSE[@]}" logs --no-color --tail 100 formloop ;;
  esac
  unlock_service
  case "$ACTION" in
    up) printf 'Formloop: http://127.0.0.1:%s\n' "$FORMLOOP_PORT" ;;
    mcp) exec "${MCP[@]}" ;;
  esac
}

main "$@"
