{
  "mcpServers": {
    "blender-mcp": {
      "command": "uvx",
      "args": ["--python", "3.11", "blender-mcp"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-managed",
        "BLENDER_MCP_SAFE_MODE": "1",
        "DISABLE_TELEMETRY": "true"
      },
      "requestTimeoutMs": 120000
    },
    "svelte": {
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp"],
      "requestTimeoutMs": 120000,
      "directTools": false
    },
    "web-search": {
      "command": "sh",
      "args": ["-c", "exec node \"${WEB_SEARCH_MCP_BIN:?set WEB_SEARCH_MCP_BIN}\""],
      "requestTimeoutMs": 120000,
      "directTools": false
    },
    "android-mcp": {
      "command": "uvx",
      "args": ["--python", "3.13", "android-mcp"],
      "requestTimeoutMs": 120000,
      "directTools": false
    },
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "!gh auth token"
      },
      "requestTimeoutMs": 120000,
      "directTools": false
    },
    "ssh-mcp": {
      "command": "npx",
      "args": ["ssh-mcp", "--config=.pi/ssh-mcp/config.toml"],
      "requestTimeoutMs": 120000,
      "directTools": false,
      "description": "Controlled SSH access to remote hosts (security-first, approval-gated)"
    },
    "docs-mcp-server": {
      "command": "npx",
      "args": ["-y", "@arabold/docs-mcp-server@latest"],
      "requestTimeoutMs": 120000,
      "directTools": false
    }
  },
  "settings": {
    "scriptMode": true
  }
}
