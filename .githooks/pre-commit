#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
application_root="$repository_root/src"

if [ ! -d "$application_root/node_modules" ]; then
  echo "Missing src/node_modules; run mix assets.setup before committing." >&2
  exit 1
fi

cd "$application_root"
export PATH="$HOME/.local/share/elixir/bin:$PATH"
mix precommit
