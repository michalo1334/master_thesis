# File-based log ingestion.
#
# Grafana Alloy tails the structured JSON written by the Elixir :logger file
# handler (see src/config/runtime.exs) and pushes to Loki. Tailing a file (not
# the container stdio) excludes non-Logger noise — compile output, IEx prompts,
# and framework banners — which never reach Logger and therefore never reach
# this file. The file is shared with Alloy via the `network-defense-logs` volume.
#
# Trace-context correlation still works because the logger_json formatter emits
# `trace` and `span` fields from OTel context propagation.

loki.source.file "network_defense" {
  targets = [
    {
      __path__     = "/var/log/network_defense/network_defense.jsonl",
      job          = "network_defense",
      app          = "network_defense",
      service_name = "network_defense",
    },
  ]
  forward_to = [loki.process.network_defense.receiver]
}

loki.process "network_defense" {
  forward_to = [loki.write.network_defense.receiver]

  stage.json {
    expressions = {
      level      = "severity",
      trace_id   = "trace",
      span_id    = "span",
      request_id = "metadata.request_id",
      time       = "time",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = { level = "" }
  }

  stage.structured_metadata {
    values = { trace_id = "", span_id = "", request_id = "" }
  }
}

loki.write "network_defense" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}