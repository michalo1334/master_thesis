discovery.docker "network_defense" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "network_defense" {
	targets = discovery.docker.network_defense.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/network-defense-app"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
	}
}

loki.source.docker "network_defense" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.network_defense.output
	labels     = {"job" = "network_defense", "app" = "network_defense", "service_name" = "network_defense"}
	forward_to = [loki.process.network_defense.receiver]
}

loki.process "network_defense" {
	forward_to = [loki.write.network_defense.receiver]

	stage.json {
		expressions = {
			level      = "severity",
			trace_id   = "trace",
			span_id    = "span",
			request_id = "metadata.request_id",
			time       = "time",
		}
	}

	stage.timestamp {
		source = "time"
		format = "RFC3339Nano"
	}

	stage.labels {
		values = {"level" = ""}
	}

	stage.structured_metadata {
		values = {"trace_id" = "", "span_id" = "", "request_id" = ""}
	}
}

loki.write "network_defense" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
