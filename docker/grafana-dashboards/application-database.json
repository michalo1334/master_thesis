    {
      "id": 12,
      "type": "row",
      "title": "PostgreSQL",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}
    },
    {
      "id": 13,
      "type": "stat",
      "title": "PostgreSQL availability",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "Down"}, "1": {"color": "green", "text": "Up"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"},
      "targets": [{"expr": "pg_up{job=\"postgres\"}", "refId": "A"}]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "PostgreSQL connections",
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 32},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"},
      "targets": [{"expr": "sum(pg_stat_database_numbackends{job=\"postgres\",datname!~\"template.*\"})", "refId": "A"}]
    },
    {
      "id": 15,
      "type": "gauge",
      "title": "PostgreSQL cache-hit ratio",
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 32},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 90}, {"color": "green", "value": 99}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{"expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"postgres\",datname!~\"template.*\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{job=\"postgres\",datname!~\"template.*\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\",datname!~\"template.*\"}[$__rate_interval])))", "refId": "A"}]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "PostgreSQL transactions",
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 32},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_xact_commit{job=\"postgres\",datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "commits", "refId": "A"},
        {"expr": "sum(rate(pg_stat_database_xact_rollback{job=\"postgres\",datname!~\"template.*\"}[$__rate_interval]))", "legendFormat": "rollbacks", "refId": "B"}
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "PostgreSQL database size",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 39},
      "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "pg_database_size_bytes{job=\"postgres\",datname!~\"template.*\"}", "legendFormat": "{{datname}}", "refId": "A"}]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "PostgreSQL locks",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 39},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (mode) (pg_locks_count{job=\"postgres\"})", "legendFormat": "{{mode}}", "refId": "A"}]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "PostgreSQL long-running transactions",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 47},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "pg_long_running_transactions{job=\"postgres\"} or on(job, instance) (0 * pg_up{job=\"postgres\"})", "legendFormat": "transactions", "refId": "A"}]
    }
  ],
